{
  "mcpServers": {
    "1c-data": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--add-host=host.docker.internal:host-gateway",
        "-e", "ONEC_USER",
        "-e", "ONEC_PASSWORD",
        "-e", "SPRING_PROFILES_ACTIVE=docker",
        "-e", "JAVA_TOOL_OPTIONS=-Dfile.encoding=UTF-8",
        "1c-data-mcp-server:latest"
      ],
      "env": {
        "ONEC_USER": "datamcp",
        "ONEC_PASSWORD": "1"
      }
    }
  }
}
