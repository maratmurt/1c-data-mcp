Процедура НазначитьРоль() Экспорт
	ИмяПользователя = "datamcp";
	ИмяРоли = "DataMcpReadOnly";
	
	Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	Если Пользователь = Неопределено Тогда
		ВызватьИсключение "Пользователь не найден: " + ИмяПользователя;
	КонецЕсли;
	
	Роль = Метаданные.Роли.Найти(ИмяРоли);
	Если Роль = Неопределено Тогда
		ВызватьИсключение "Роль не найдена: " + ИмяРоли;
	КонецЕсли;
	
	Если Пользователь.Роли.Содержит(Роль) Тогда
		Сообщить("Роль уже назначена: " + ИмяРоли);
		Возврат;
	КонецЕсли;
	
	Пользователь.Роли.Добавить(Роль);
	Пользователь.Записать();
	Сообщить("Роль назначена: " + ИмяРоли + " -> " + ИмяПользователя);
КонецПроцедуры

НазначитьРоль();
