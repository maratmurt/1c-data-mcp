#Область ПрограммныйИнтерфейс

// Возвращает структуру состояния сервиса для ping.
//
// Возвращаемое значение:
//  Структура - status, configuration, version
//
Функция Ping() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("status", "ok");
	Результат.Вставить("configuration", Метаданные.Имя);
	Результат.Вставить("version", Метаданные.Версия);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
