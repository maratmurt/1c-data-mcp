// Общие функции HTTP API DataMcp.

#Область ПрограммныйИнтерфейс

// Возвращает структуру состояния сервиса для ping.
//
// Возвращаемое значение:
//  Структура - status, configuration, version
//
Функция Ping() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("status", "ok");
	Результат.Вставить("configuration", Метаданные.Имя);
	Результат.Вставить("version", Метаданные.Версия);
	
	Возврат Результат;
	
КонецФункции

// Сводка метаданных конфигурации: имя, версия, счётчики по типам P0.
//
// Возвращаемое значение:
//  Структура - configuration, version, counts
//
Функция ПолучитьСводкуМетаданных() Экспорт
	
	Счетчики = Новый Структура;
	Для Каждого ОписаниеТипа Из ТипыМетаданныхP0() Цикл
		Коллекция = КоллекцияМетаданныхПоТипу(ОписаниеТипа.type);
		Счетчики.Вставить(ОписаниеТипа.type, Коллекция.Количество());
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("configuration", Метаданные.Имя);
	Результат.Вставить("version", Метаданные.Версия);
	Результат.Вставить("counts", Счетчики);
	
	Возврат Результат;
	
КонецФункции

// Плоский список объектов метаданных с пагинацией.
//
// Параметры:
//  Типы - Массив - имена типов (Catalog, Document, ...) или Неопределено для всех P0
//  Смещение - Число
//  Лимит - Число
//
// Возвращаемое значение:
//  Структура - items, total, offset, limit
//
Функция ПолучитьСписокОбъектов(Типы, Смещение, Лимит) Экспорт
	
	Если Смещение = Неопределено Тогда
		Смещение = 0;
	КонецЕсли;
	
	Если Лимит = Неопределено Или Лимит <= 0 Тогда
		Лимит = 100;
	КонецЕсли;
	
	ВсеОбъекты = СобратьСсылкиОбъектов(Типы);
	Всего = ВсеОбъекты.Количество();
	
	Элементы = Новый Массив;
	КонецИндекса = Мин(Смещение + Лимит, Всего) - 1;
	
	Для Индекс = Смещение По КонецИндекса Цикл
		Элементы.Добавить(ВсеОбъекты[Индекс]);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("items", Элементы);
	Результат.Вставить("total", Всего);
	Результат.Вставить("offset", Смещение);
	Результат.Вставить("limit", Лимит);
	
	Возврат Результат;
	
КонецФункции

// Поиск объектов метаданных по подстроке в имени и синониме.
//
// Параметры:
//  Запрос - Строка
//  Типы - Массив
//  Лимит - Число
//
// Возвращаемое значение:
//  Структура - items
//
Функция НайтиОбъекты(Запрос, Типы, Лимит) Экспорт
	
	Если Лимит = Неопределено Или Лимит <= 0 Тогда
		Лимит = 20;
	КонецЕсли;
	
	ЗапросВРег = ВРег(СокрЛП(Запрос));
	Элементы = Новый Массив;
	
	Для Каждого ОписаниеТипа Из ТипыМетаданныхP0(Типы) Цикл
		Коллекция = КоллекцияМетаданныхПоТипу(ОписаниеТипа.type);
		Для Каждого МД Из Коллекция Цикл
			Если ОбъектСоответствуетПоиску(МД, ЗапросВРег) Тогда
				Элементы.Добавить(СсылкаНаОбъект(ОписаниеТипа.type, МД));
				Если Элементы.Количество() >= Лимит Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Элементы.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("items", Элементы);
	
	Возврат Результат;
	
КонецФункции

// Описание структуры объекта метаданных (overview).
//
// Параметры:
//  Тип - Строка - Catalog, Document, ...
//  Имя - Строка
//
// Возвращаемое значение:
//  Структура - описание или Неопределено если не найден
//
Функция ОписатьОбъект(Тип, Имя) Экспорт
	
	МД = НайтиОбъектМетаданных(Тип, Имя);
	Если МД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = СсылкаНаОбъект(Тип, МД);
	Результат.Вставить("attributes", Новый Массив);
	Результат.Вставить("tabularSections", Новый Массив);
	Результат.Вставить("dimensions", Новый Массив);
	Результат.Вставить("resources", Новый Массив);
	Результат.Вставить("values", Новый Массив);
	Результат.Вставить("virtualTables", Новый Массив);
	
	Если Тип = "Enum" Тогда
		Для Каждого ЗначениеПеречисления Из МД.ЗначенияПеречисления Цикл
			Элемент = Новый Структура;
			Элемент.Вставить("name", ЗначениеПеречисления.Имя);
			Элемент.Вставить("synonym", СинонимМетаданных(ЗначениеПеречисления));
			Результат.values.Добавить(Элемент);
		КонецЦикла;
	ИначеЕсли Тип = "InformationRegister" Или Тип = "AccumulationRegister" Тогда
		ДобавитьКоллекциюРеквизитов(Результат.dimensions, МД.Измерения);
		ДобавитьКоллекциюРеквизитов(Результат.resources, МД.Ресурсы);
		ДобавитьКоллекциюРеквизитов(Результат.attributes, МД.Реквизиты);
		Если Тип = "AccumulationRegister" Тогда
			Результат.virtualTables.Добавить("Остатки");
			Результат.virtualTables.Добавить("Обороты");
			Результат.virtualTables.Добавить("ОстаткиИОбороты");
		КонецЕсли;
	Иначе
		ДобавитьКоллекциюРеквизитов(Результат.attributes, МД.Реквизиты);
		Для Каждого ТабличнаяЧасть Из МД.ТабличныеЧасти Цикл
			ОписаниеТЧ = Новый Структура;
			ОписаниеТЧ.Вставить("name", ТабличнаяЧасть.Имя);
			ОписаниеТЧ.Вставить("synonym", СинонимМетаданных(ТабличнаяЧасть));
			ОписаниеТЧ.Вставить("attributes", Новый Массив);
			ДобавитьКоллекциюРеквизитов(ОписаниеТЧ.attributes, ТабличнаяЧасть.Реквизиты);
			Результат.tabularSections.Добавить(ОписаниеТЧ);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Сериализует ОписаниеТипов в JSON-совместимый массив типов.
//
Функция СериализоватьТип(ОписаниеТипов) Экспорт
	
	Результат = Новый Массив;
	
	Для Каждого ТипЗначения Из ОписаниеТипов.Типы() Цикл
		Результат.Добавить(ПредставлениеТипаЗначения(ТипЗначения, ОписаниеТипов));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Выполняет read-only запрос после проверки SecuritySvc.
//
// Параметры:
//  ТекстЗапроса - Строка
//  ПараметрыJSON - Структура, Соответствие или Неопределено
//  МаксСтрок - Число - верхняя граница для ПЕРВЫЕ N
//
// Возвращаемое значение:
//  Структура - columns, rows, rowCount, truncated, executionMs
//
Функция ВыполнитьЗапрос(ТекстЗапроса, ПараметрыJSON, МаксСтрок) Экспорт
	
	Если МаксСтрок = Неопределено Или МаксСтрок <= 0 Тогда
		МаксСтрок = 1000;
	КонецЕсли;
	
	ПроверитьЗапрос(ТекстЗапроса, МаксСтрок);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Если ПараметрыJSON <> Неопределено Тогда
		Параметры = ПреобразоватьПараметрыИзJSON(ПараметрыJSON);
		Для Каждого КлючИЗначение Из Параметры Цикл
			Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПривилегированныйРежимБыл = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		УстановитьПривилегированныйРежим(ПривилегированныйРежимБыл);
		ВызватьИсключение;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(ПривилегированныйРежимБыл);
	ВремяВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	
	Возврат СериализоватьРезультатЗапроса(РезультатЗапроса, МаксСтрок, ВремяВыполнения);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТипыМетаданныхP0(ФильтрТипов = Неопределено)
	
	ВсеТипы = Новый Массив;
	ВсеТипы.Добавить(Новый Структура("type, queryPrefix", "Catalog", "Справочник"));
	ВсеТипы.Добавить(Новый Структура("type, queryPrefix", "Document", "Документ"));
	ВсеТипы.Добавить(Новый Структура("type, queryPrefix", "Enum", "Перечисление"));
	ВсеТипы.Добавить(Новый Структура("type, queryPrefix", "InformationRegister", "РегистрСведений"));
	ВсеТипы.Добавить(Новый Структура("type, queryPrefix", "AccumulationRegister", "РегистрНакопления"));
	
	Если ФильтрТипов = Неопределено Или ТипЗнч(ФильтрТипов) <> Тип("Массив") Или ФильтрТипов.Количество() = 0 Тогда
		Возврат ВсеТипы;
	КонецЕсли;
	
	Отфильтрованные = Новый Массив;
	Для Каждого ОписаниеТипа Из ВсеТипы Цикл
		Если ФильтрТипов.Найти(ОписаниеТипа.type) <> Неопределено Тогда
			Отфильтрованные.Добавить(ОписаниеТипа);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Отфильтрованные;
	
КонецФункции

Функция КоллекцияМетаданныхПоТипу(Тип)
	
	Если Тип = "Catalog" Тогда
		Возврат Метаданные.Справочники;
	ИначеЕсли Тип = "Document" Тогда
		Возврат Метаданные.Документы;
	ИначеЕсли Тип = "Enum" Тогда
		Возврат Метаданные.Перечисления;
	ИначеЕсли Тип = "InformationRegister" Тогда
		Возврат Метаданные.РегистрыСведений;
	ИначеЕсли Тип = "AccumulationRegister" Тогда
		Возврат Метаданные.РегистрыНакопления;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПрефиксЗапросаПоТипу(Тип)
	
	Для Каждого ОписаниеТипа Из ТипыМетаданныхP0() Цикл
		Если ОписаниеТипа.type = Тип Тогда
			Возврат ОписаниеТипа.queryPrefix;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция СсылкаНаОбъект(Тип, МД)
	
	Результат = Новый Структура;
	Результат.Вставить("type", Тип);
	Результат.Вставить("name", МД.Имя);
	Результат.Вставить("synonym", СинонимМетаданных(МД));
	Результат.Вставить("fullName", Тип + "." + МД.Имя);
	Результат.Вставить("queryName", ПрефиксЗапросаПоТипу(Тип) + "." + МД.Имя);
	
	Возврат Результат;
	
КонецФункции

Функция СинонимМетаданных(МД)
	
	Синоним = МД.Синоним;
	Если Синоним = Неопределено Тогда
		Возврат МД.Имя;
	КонецЕсли;
	
	Возврат Строка(Синоним);
	
КонецФункции

Функция СобратьСсылкиОбъектов(Типы)
	
	Результат = Новый Массив;
	
	Для Каждого ОписаниеТипа Из ТипыМетаданныхP0(Типы) Цикл
		Коллекция = КоллекцияМетаданныхПоТипу(ОписаниеТипа.type);
		Для Каждого МД Из Коллекция Цикл
			Результат.Добавить(СсылкаНаОбъект(ОписаниеТипа.type, МД));
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОбъектСоответствуетПоиску(МД, ЗапросВРег)
	
	Если ПустаяСтрока(ЗапросВРег) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат СтрНайти(ВРег(МД.Имя), ЗапросВРег) > 0
		Или СтрНайти(ВРег(СинонимМетаданных(МД)), ЗапросВРег) > 0;
	
КонецФункции

Функция НайтиОбъектМетаданных(Тип, Имя)
	
	Коллекция = КоллекцияМетаданныхПоТипу(Тип);
	Если Коллекция = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Коллекция.Найти(Имя);
	
КонецФункции

Процедура ДобавитьКоллекциюРеквизитов(МассивНазначения, КоллекцияРеквизитов)
	
	Для Каждого Реквизит Из КоллекцияРеквизитов Цикл
		Описание = Новый Структура;
		Описание.Вставить("name", Реквизит.Имя);
		Описание.Вставить("synonym", СинонимМетаданных(Реквизит));
		Описание.Вставить("types", СериализоватьТип(Реквизит.Тип));
		Описание.Вставить("nullable", Не Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку);
		МассивНазначения.Добавить(Описание);
	КонецЦикла;
	
КонецПроцедуры

Функция ПредставлениеТипаЗначения(ТипЗначения, ОписаниеТипов)
	
	Если ТипЗначения = Тип("Число") Тогда
		Квалификаторы = ОписаниеТипов.КвалификаторыЧисла;
		Возврат Новый Структура("kind, digits, fraction", "Number", Квалификаторы.Разрядность, Квалификаторы.РазрядностьДробнойЧасти);
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Квалификаторы = ОписаниеТипов.КвалификаторыСтроки;
		Возврат Новый Структура("kind, length", "String", Квалификаторы.Длина);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Новый Структура("kind", "Date");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат Новый Структура("kind", "Boolean");
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Новый Структура("kind", "UUID");
	КонецЕсли;
	
	Возврат XMLТип(ТипЗначения).ИмяТипа;
	
КонецФункции

// SecuritySvc: проверка текста запроса перед выполнением.
Процедура ПроверитьЗапрос(ТекстЗапроса, МаксСтрок)
	
	Текст = СокрЛП(ТекстЗапроса);
	Если ПустаяСтрока(Текст) Тогда
		ВызватьИсключение "Query text is empty";
	КонецЕсли;
	
	ТекстВРег = ВРег(Текст);
	ЗапрещенныеТокены = ЗапрещенныеТокеныЗапроса();
	Для Каждого Токен Из ЗапрещенныеТокены Цикл
		Если СтрНайти(ТекстВРег, Токен) > 0 Тогда
			ВызватьИсключение "Forbidden token in query: " + Токен;
		КонецЕсли;
	КонецЦикла;
	
	Части = СтрРазделить(Текст, ";", Ложь);
	ПоследняяЧасть = "";
	Для Каждого Часть Из Части Цикл
		ЧастьТекст = СокрЛП(Часть);
		Если ПустаяСтрока(ЧастьТекст) Тогда
			Продолжить;
		КонецЕсли;
		Если Не СтрНачинаетсяС(ВРег(ЧастьТекст), "ВЫБРАТЬ") Тогда
			ВызватьИсключение "Each query statement must start with ВЫБРАТЬ";
		КонецЕсли;
		ПоследняяЧасть = ЧастьТекст;
	КонецЦикла;
	
	Если ПустаяСтрока(ПоследняяЧасть) Тогда
		ВызватьИсключение "Query text is empty";
	КонецЕсли;
	
	КоличествоСтрок = ИзвлечьПервыеN(ПоследняяЧасть);
	Если КоличествоСтрок <= 0 Тогда
		ВызватьИсключение "Query must contain ПЕРВЫЕ N in the final SELECT";
	КонецЕсли;
	
	Если КоличествоСтрок > МаксСтрок Тогда
		ВызватьИсключение "ПЕРВЫЕ N exceeds max rows limit: " + Формат(МаксСтрок, "ЧГ=0");
	КонецЕсли;
	
КонецПроцедуры

Функция ЗапрещенныеТокеныЗапроса()
	
	Токены = Новый Массив;
	Токены.Добавить("РАЗРЕШИТЬ");
	Токены.Добавить("ВНЕШНИЕ");
	Токены.Добавить("ИЗМЕНИТЬ");
	Токены.Добавить("УДАЛИТЬ");
	Токены.Добавить("ВСТАВИТЬ");
	Токены.Добавить("ОБНОВИТЬ");
	
	Возврат Токены;
	
КонецФункции

Функция ИзвлечьПервыеN(Текст)
	
	ТекстВРег = ВРег(Текст);
	Позиция = СтрНайти(ТекстВРег, "ПЕРВЫЕ");
	Если Позиция = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Остаток = СокрЛ(Сред(Текст, Позиция + СтрДлина("ПЕРВЫЕ")));
	ЧислоСтрока = "";
	Для Индекс = 1 По СтрДлина(Остаток) Цикл
		Символ = Сред(Остаток, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			ЧислоСтрока = ЧислоСтрока + Символ;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ПустаяСтрока(ЧислоСтрока) Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Число(ЧислоСтрока);
	
КонецФункции

Функция ПреобразоватьПараметрыИзJSON(ПараметрыJSON)
	
	Результат = Новый Соответствие;
	ТипJSON = ТипЗнч(ПараметрыJSON);
	
	Если ТипJSON = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из ПараметрыJSON Цикл
			Результат.Вставить(КлючИЗначение.Ключ, ПреобразоватьЗначениеПараметра(КлючИЗначение.Значение));
		КонецЦикла;
	ИначеЕсли ТипJSON = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из ПараметрыJSON Цикл
			Результат.Вставить(Строка(КлючИЗначение.Ключ), ПреобразоватьЗначениеПараметра(КлючИЗначение.Значение));
		КонецЦикла;
	Иначе
		ВызватьИсключение "parameters must be a JSON object";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПреобразоватьЗначениеПараметра(ЗначениеJSON)
	
	ТипJSON = ТипЗнч(ЗначениеJSON);
	
	Если ЗначениеJSON = Null Тогда
		Возврат Неопределено;
	ИначеЕсли ТипJSON = Тип("Булево") Или ТипJSON = Тип("Число") Тогда
		Возврат ЗначениеJSON;
	ИначеЕсли ТипJSON = Тип("Строка") Тогда
		Возврат ПреобразоватьСтроковыйПараметр(ЗначениеJSON);
	ИначеЕсли ТипJSON = Тип("Структура") Тогда
		Возврат ПреобразоватьСсылочныйПараметр(ЗначениеJSON);
	ИначеЕсли ТипJSON = Тип("Соответствие") Тогда
		Структура = Новый Структура;
		Для Каждого КлючИЗначение Из ЗначениеJSON Цикл
			Структура.Вставить(Строка(КлючИЗначение.Ключ), КлючИЗначение.Значение);
		КонецЦикла;
		Возврат ПреобразоватьСсылочныйПараметр(Структура);
	КонецЕсли;
	
	Возврат ЗначениеJSON;
	
КонецФункции

Функция ПреобразоватьСтроковыйПараметр(Значение)
	
	Если СтрДлина(Значение) >= 10
		И Сред(Значение, 5, 1) = "-"
		И Сред(Значение, 8, 1) = "-" Тогда
		Попытка
			Возврат XMLЗначение(Тип("dateTime"), Значение);
		Исключение
			// Оставляем строкой при неоднозначности.
		КонецПопытки;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция ПреобразоватьСсылочныйПараметр(ЗначениеJSON)
	
	Uuid = "";
	ТипСсылки = "";
	
	Если ТипЗнч(ЗначениеJSON) = Тип("Структура") Тогда
		Если ЗначениеJSON.Свойство("uuid") Тогда
			Uuid = ЗначениеJSON.uuid;
		КонецЕсли;
		Если ЗначениеJSON.Свойство("type") Тогда
			ТипСсылки = ЗначениеJSON.type;
		КонецЕсли;
	КонецЕсли;
	
	Если ПустаяСтрока(Uuid) Или ПустаяСтрока(ТипСсылки) Тогда
		ВызватьИсключение "Reference parameter requires uuid and type";
	КонецЕсли;
	
	Возврат ПолучитьСсылкуПоТипуИUuid(ТипСсылки, Uuid);
	
КонецФункции

Функция ПолучитьСсылкуПоТипуИUuid(ТипСсылки, Uuid)
	
	Позиция = СтрНайти(ТипСсылки, ".");
	Если Позиция = 0 Тогда
		ВызватьИсключение "Invalid reference type: " + ТипСсылки;
	КонецЕсли;
	
	Префикс = Лев(ТипСсылки, Позиция - 1);
	Имя = Сред(ТипСсылки, Позиция + 1);
	Менеджер = МенеджерСсылкиПоПрефиксу(Префикс, Имя);
	
	Если Менеджер = Неопределено Тогда
		ВызватьИсключение "Unsupported reference type: " + ТипСсылки;
	КонецЕсли;
	
	Попытка
		Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Uuid));
	Исключение
		ВызватьИсключение "Invalid reference uuid for parameter: " + Uuid;
	КонецПопытки;
	
КонецФункции

Функция МенеджерСсылкиПоПрефиксу(Префикс, Имя)
	
	Если Префикс = "CatalogRef" Тогда
		Возврат Справочники[Имя];
	ИначеЕсли Префикс = "DocumentRef" Тогда
		Возврат Документы[Имя];
	ИначеЕсли Префикс = "EnumRef" Тогда
		Возврат Перечисления[Имя];
	ИначеЕсли Префикс = "ChartOfCharacteristicTypesRef" Тогда
		Возврат ПланыВидовХарактеристик[Имя];
	ИначеЕсли Префикс = "ChartOfAccountsRef" Тогда
		Возврат ПланыСчетов[Имя];
	ИначеЕсли Префикс = "ChartOfCalculationTypesRef" Тогда
		Возврат ПланыВидовРасчета[Имя];
	ИначеЕсли Префикс = "BusinessProcessRef" Тогда
		Возврат БизнесПроцессы[Имя];
	ИначеЕсли Префикс = "TaskRef" Тогда
		Возврат Задачи[Имя];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция СериализоватьРезультатЗапроса(РезультатЗапроса, МаксСтрок, ВремяВыполнения)
	
	Колонки = Новый Массив;
	Для Индекс = 0 По РезультатЗапроса.Колонки.Количество() - 1 Цикл
		Колонка = РезультатЗапроса.Колонки[Индекс];
		ОписаниеКолонки = Новый Структура;
		ОписаниеКолонки.Вставить("name", Колонка.Имя);
		ОписаниеКолонки.Вставить("type", ИмяТипаКолонки(Колонка.ТипЗначения));
		Колонки.Добавить(ОписаниеКолонки);
	КонецЦикла;
	
	Строки = Новый Массив;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаДанных = Новый Структура;
		Для Индекс = 0 По РезультатЗапроса.Колонки.Количество() - 1 Цикл
			ИмяКолонки = РезультатЗапроса.Колонки[Индекс].Имя;
			СтрокаДанных.Вставить(ИмяКолонки, СериализоватьЗначение(Выборка[ИмяКолонки]));
		КонецЦикла;
		Строки.Добавить(СтрокаДанных);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("rowCount", Строки.Количество());
	Результат.Вставить("truncated", Строки.Количество() >= МаксСтрок);
	Результат.Вставить("executionMs", ВремяВыполнения);
	
	Возврат Результат;
	
КонецФункции

Функция ИмяТипаКолонки(ОписаниеТипов)
	
	Типы = ОписаниеТипов.Типы();
	Если Типы.Количество() = 0 Тогда
		Возврат "Unknown";
	КонецЕсли;
	
	Возврат XMLТип(Типы[0]).ИмяТипа;
	
КонецФункции

Функция СериализоватьЗначение(Значение)
	
	Если Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат XMLСтрока(Значение);
	ИначеЕсли ЭтоСсылка(Значение) Тогда
		Возврат СериализоватьСсылку(Значение);
	КонецЕсли;
	
	Возврат Строка(Значение);
	
КонецФункции

Функция ЭтоСсылка(Значение)
	
	Если Значение = Null Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Значение.УникальныйИдентификатор();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция СериализоватьСсылку(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("uuid", Строка(Ссылка.УникальныйИдентификатор()));
	Результат.Вставить("type", XMLТип(ТипЗнч(Ссылка)).ИмяТипа);
	Результат.Вставить("presentation", Строка(Ссылка));
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
