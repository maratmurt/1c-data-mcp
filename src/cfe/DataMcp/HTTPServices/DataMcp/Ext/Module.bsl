
Функция pingGet(Запрос)
	
	Возврат ОтветJSON(DataMcp_Общий.Ping(), 200);
	
КонецФункции

Функция metadataGet(Запрос)
	
	Параметры = Запрос.ПараметрыЗапроса;
	Режим = НРег(ЗначениеПараметра(Параметры, "mode", "summary"));
	Типы = РазобратьСписокТипов(ЗначениеПараметра(Параметры, "types", ""));
	
	Если Режим = "list" Тогда
		Смещение = ЧислоПараметра(Параметры, "offset", 0);
		Лимит = ЧислоПараметра(Параметры, "limit", 100);
		Данные = DataMcp_Общий.ПолучитьСписокОбъектов(Типы, Смещение, Лимит);
	Иначе
		Данные = DataMcp_Общий.ПолучитьСводкуМетаданных();
	КонецЕсли;
	
	Возврат ОтветJSON(Данные, 200);
	
КонецФункции

Функция objectsSearchGet(Запрос)
	
	Параметры = Запрос.ПараметрыЗапроса;
	ЗапросПоиска = ЗначениеПараметра(Параметры, "q", "");
	Типы = РазобратьСписокТипов(ЗначениеПараметра(Параметры, "types", ""));
	Лимит = ЧислоПараметра(Параметры, "limit", 20);
	
	Данные = DataMcp_Общий.НайтиОбъекты(ЗапросПоиска, Типы, Лимит);
	
	Возврат ОтветJSON(Данные, 200);
	
КонецФункции

Функция objectsTypeNameGet(Запрос)
	
	Тип = Запрос.ПараметрыURL.Получить("type");
	Имя = Запрос.ПараметрыURL.Получить("name");
	
	Данные = DataMcp_Общий.ОписатьОбъект(Тип, Имя);
	Если Данные = Неопределено Тогда
		Возврат ОтветJSON(Новый Структура("error", "Object not found: " + Тип + "." + Имя), 404);
	КонецЕсли;
	
	Возврат ОтветJSON(Данные, 200);
	
КонецФункции

Функция ОтветJSON(Данные, КодСостояния)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	ТелоОтвета = ЗаписьJSON.Закрыть();
	
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета, КодировкаТекста.UTF8);
	
	Возврат Ответ;
	
КонецФункции

Функция ЗначениеПараметра(Параметры, Имя, ЗначениеПоУмолчанию)
	
	Значение = Параметры.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция ЧислоПараметра(Параметры, Имя, ЗначениеПоУмолчанию)
	
	Значение = ЗначениеПараметра(Параметры, Имя, ЗначениеПоУмолчанию);
	
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;
	
КонецФункции

Функция РазобратьСписокТипов(СтрокаТипов)
	
	Если ПустаяСтрока(СокрЛП(СтрокаТипов)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Части = СтрРазделить(СтрокаТипов, ",", Ложь);
	Результат = Новый Массив;
	
	Для Каждого Часть Из Части Цикл
		ИмяТипа = СокрЛП(Часть);
		Если Не ПустаяСтрока(ИмяТипа) Тогда
			Результат.Добавить(ИмяТипа);
		КонецЕсли;
	КонецЦикла;
	
	Если Результат.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
