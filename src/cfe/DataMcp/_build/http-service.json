{
  "type": "HTTPService",
  "name": "DataMcp",
  "synonym": "Data MCP HTTP API",
  "rootURL": "datamcp",
  "urlTemplates": {
    "ping": {
      "template": "v1/ping",
      "methods": {
        "Get": "GET"
      }
    },
    "metadata": {
      "template": "v1/metadata",
      "methods": {
        "Get": "GET"
      }
    },
    "objects_search": {
      "template": "v1/objects/search",
      "methods": {
        "Get": "GET"
      }
    },
    "objects_type_name": {
      "template": "v1/objects/{type}/{name}",
      "methods": {
        "Get": "GET"
      }
    },
    "query": {
      "template": "v1/query",
      "methods": {
        "Post": "POST"
      }
    }
  }
}
